<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 0; width: auto; height: auto; top: 0; left: 0; right: 0; bottom: 402px; flex-direction: row; background-color: rgba(0, 0, 0, 0); align-self: auto; justify-content: flex-start; align-items: auto; align-content: flex-start;">
        <engine:VisualElement name="Image" style="flex-grow: 0; width: 20%; background-position-x: center 0; background-position-y: center 0; background-image: none; background-size: 100% 100%; align-self: auto; align-items: auto; height: 100%; right: 0; flex-shrink: 0; justify-content: center; align-content: auto;" />
        <engine:Label text="Label" name="counter" style="width: 75%; height: auto; color: rgb(255, 255, 255); font-size: 26%; -unity-font-definition: resource(&apos;FlatSkin/Font/Roboto-Medium&apos;); -unity-font-style: normal; -unity-text-align: middle-left; white-space: nowrap; left: 5%; align-items: auto; align-content: auto; bottom: 12%;" />
    </engine:VisualElement>
</engine:UXML>
